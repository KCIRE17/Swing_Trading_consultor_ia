# ============================================================
#  CONFIGURACION - Swing Trading Consultor IA
#  Copia este archivo como .env y rellena los valores.
#
#      copy .env.example .env
#
#  .env esta en .gitignore: nunca lo subas al repositorio.
#  Si trabajas en Windows tambien puedes usar config.bat, que
#  run.bat carga por ti. Las variables ya definidas en el
#  sistema tienen prioridad sobre este archivo.
# ============================================================


# --- Supabase (opcional) ------------------------------------
# Sin esta variable la app arranca igual y usa yfinance en
# vivo como fuente de precios, sin persistencia.
# Project Settings > Database > Connection string
# Usa el pooler de transaccion (puerto 6543) para la app.
DATABASE_URL=


# --- Google Gemini (opcional) --------------------------------
# Sin clave la app degrada con normalidad: la narrativa cualitativa
# y las noticias simplemente se omiten.
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=


# --- Modelos de Gemini (opcional) ---------------------------
# Si los dejas vacios se usan los valores por defecto del codigo.
GEMINI_MODEL=
GEMINI_NARRATIVE_MODEL=


# --- Ruta del modelo de sentimiento (opcional) ---------------
# Solo si mueves models/ a otro sitio. En Docker y PyInstaller
# la app ya la resuelve sola.
SENTIMENT_MODEL_DIR=
