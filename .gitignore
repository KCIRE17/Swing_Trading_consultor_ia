# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Env files (secrets)
.env
config.bat

# Deploy logs
*.log
log.json
*-log-export-*.json

# Modelo de sentimiento
# Se versiona sentiment_model.joblib + sentiment_meta.json para que la app
# funcione sin reentrenar. El resto de artefactos de entrenamiento se ignoran.
models/*
!models/sentiment_model.joblib
!models/sentiment_meta.json
models/*.pkl
models/*.tmp
